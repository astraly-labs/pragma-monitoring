          "execErrState": "Alerting",
          "for": "5m",
          "annotations": {
            "summary": "PRAGMA publisher stopped",
            "description": "PRAGMA has no observed submission for 40 minutes, or its metric is missing. Confirm process health, RPC, STRK gas and last accepted transaction. Confirm sustained failure for five minutes. The deployed mainnet configuration uses an 1800-second heartbeat."
          },
          "labels": {
            "service": "pragma-oracle",
            "severity": "critical"
          },
          "isPaused": false
