{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "pragma-oracle-safety",
      "folder": "onchain",
      "interval": 60,
      "rules": [
        {
          "uid": "pragma-monitor-missing",
          "title": "Monitoring telemetry missing",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": {
                "from": 1200,
                "to": 0
              },
              "datasourceUid": "eemnwzj4tmubke",
              "model": {
                "refId": "A",
                "expr": "absent_over_time(pragma_indexer_latest_block{network=\"Mainnet\"}[5m]) or vector(0)",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "datasource": {
                  "type": "prometheus",
                  "uid": "eemnwzj4tmubke"
                }
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [0.5]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "query": {
                      "params": ["B"]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "for": "5m",
          "annotations": {
            "summary": "Monitoring telemetry missing",
            "description": "The oracle monitor has stopped reporting. Check the process, OTEL collector, Mimir and indexer; do not interpret missing data as healthy."
          },
          "labels": {
            "service": "pragma-oracle",
            "severity": "critical"
          },
          "isPaused": false
        },
        {
          "uid": "pragma-indexer-stalled",
          "title": "Oracle indexer stopped advancing",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": {
                "from": 1200,
                "to": 0
              },
              "datasourceUid": "eemnwzj4tmubke",
              "model": {
                "refId": "A",
                "expr": "((max_over_time(pragma_indexer_latest_block{network=\"Mainnet\"}[20m]) - min_over_time(pragma_indexer_latest_block{network=\"Mainnet\"}[20m])) == bool 0)",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "datasource": {
                  "type": "prometheus",
                  "uid": "eemnwzj4tmubke"
                }
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [0.5]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "query": {
                      "params": ["B"]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "for": "5m",
          "annotations": {
            "summary": "Oracle indexer stopped advancing",
            "description": "No indexed-block progress for 20 minutes. Check Starknet head and indexer lag before trusting freshness gauges."
          },
          "labels": {
            "service": "pragma-oracle",
            "severity": "critical"
          },
          "isPaused": false
        },
        {
          "uid": "pragma-publisher-pragma",
          "title": "PRAGMA publisher stopped",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": {
                "from": 1200,
                "to": 0
              },
              "datasourceUid": "eemnwzj4tmubke",
              "model": {
                "refId": "A",
                "expr": "(max by (network,publisher) (pragma_publisher_last_update_seconds{network=\"Mainnet\",publisher=\"PRAGMA\"}) > bool 2400) or absent(pragma_publisher_last_update_seconds{network=\"Mainnet\",publisher=\"PRAGMA\"})",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "datasource": {
                  "type": "prometheus",
                  "uid": "eemnwzj4tmubke"
