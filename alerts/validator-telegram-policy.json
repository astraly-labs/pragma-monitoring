{
  "receiver": "pragma-validator-alerts",
  "object_matchers": [
    ["service", "=", "pragma-oracle"],
    ["component", "=", "starknet-validator"]
  ],
  "group_by": ["service", "component", "alertname"],
  "group_wait": "0s",
  "group_interval": "30s",
  "repeat_interval": "15m",
  "routes": [
    {
      "receiver": "pragma-validator-alerts",
      "object_matchers": [
        ["alertname", "=~", "DatasourceError|DatasourceNoData"]
      ],
      "group_by": ["service", "component", "datasource_uid", "alertname"],
      "group_wait": "2m",
      "group_interval": "5m",
      "repeat_interval": "6h"
    }
  ]
}
